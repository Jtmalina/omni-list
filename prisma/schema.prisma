generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String         @id @default(cuid())
  name                   String?
  email                  String?        @unique
  emailVerified          DateTime?
  image                  String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  autoAddListId          String?
  lastLoginAt            DateTime?      @default(now())
  accounts               Account[]
  activities             Activity[]
  follows                Follow[]
  receivedFriendRequests Friendship[]   @relation("ReceivedFriendRequests")
  sentFriendRequests     Friendship[]   @relation("SentFriendRequests")
  lists                  List[]
  listAccess             ListAccess[]
  servarrConfig          ServarrConfig?
  sessions               Session[]
}

model Friendship {
  id         String           @id @default(cuid())
  senderId   String
  receiverId String
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  receiver   User             @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User             @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model ListAccess {
  id          String      @id @default(cuid())
  listId      String
  userId      String
  accessLevel AccessLevel @default(VIEW)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  list        List        @relation(fields: [listId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
}

model ServarrConfig {
  id                     String  @id @default(cuid())
  userId                 String  @unique
  radarrUrl              String?
  radarrApiKey           String?
  radarrRootFolder       String? @default("/movies")
  radarrQualityProfileId Int?    @default(1)
  sonarrUrl              String?
  sonarrApiKey           String?
  sonarrRootFolder       String? @default("/tv")
  sonarrQualityProfileId Int?    @default(1)
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model List {
  id         String       @id @default(cuid())
  title      String
  type       ListType     @default(TODO)
  userId     String
  createdAt  DateTime     @default(now())
  activities Activity[]
  items      Item[]
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedWith ListAccess[]
  tagConfigs TagConfig[]
}

model TagConfig {
  id        String   @id @default(cuid())
  name      String
  color     String
  listId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, name])
}

model Item {
  id          String         @id @default(cuid())
  title       String
  notes       String?
  status      ItemStatus     @default(TODO)
  dueDate     DateTime?
  type        ItemType       @default(TASK)
  mediaType   MediaType?
  listId      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  color       String?
  tags        String[]
  description String?
  list        List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  media       MediaMetadata?
}

model MediaMetadata {
  id            String  @id @default(cuid())
  itemId        String  @unique
  posterPath    String?
  rating        Float?
  externalId    String?
  streamingInfo Json?
  item          Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Follow {
  id            String     @id @default(cuid())
  userId        String
  externalId    String
  type          FollowType
  mediaType     MediaType
  name          String
  posterPath    String?
  lastCheckedAt DateTime?  @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  knownFor      String?
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId, type])
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  userId    String
  listId    String?
  itemId    String?
  itemTitle String?
  metadata  Json?
  createdAt DateTime     @default(now())
  list      List?        @relation(fields: [listId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([userId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum AccessLevel {
  VIEW
  EDIT
}

enum ListType {
  TODO
  MEDIA
  CALENDAR
}

enum ItemStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum ItemType {
  TASK
  MEDIA
}

enum MediaType {
  MOVIE
  SHOW
  GAME
}

enum FollowType {
  PERSON
  STUDIO
  SERIES
}

enum ActivityType {
  ITEM_CREATED
  ITEM_COMPLETED
  ITEM_DELETED
  LIST_SHARED
  FRIEND_ACCEPTED
}
