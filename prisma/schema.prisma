generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  lists         List[]
  servarrConfig ServarrConfig?
  
  // Friends relations
  sentFriendRequests     Friendship[] @relation("SentFriendRequests")
  receivedFriendRequests Friendship[] @relation("ReceivedFriendRequests")
  
  // Shared lists access
  listAccess             ListAccess[]

  // Automation & Follows
  follows               Follow[]
  autoAddListId         String?
  lastLoginAt           DateTime? @default(now())

  // Activities
  activities            Activity[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id         String           @id @default(cuid())
  senderId   String
  sender     User             @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User             @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([senderId, receiverId])
}

enum AccessLevel {
  VIEW
  EDIT
}

model ListAccess {
  id          String      @id @default(cuid())
  listId      String
  list        List        @relation(fields: [listId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessLevel AccessLevel @default(VIEW)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([listId, userId])
}

model ServarrConfig {
  id                     String  @id @default(cuid())
  userId                 String  @unique
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  radarrUrl              String?
  radarrApiKey           String?
  radarrRootFolder       String? @default("/movies")
  radarrQualityProfileId Int?    @default(1)
  sonarrUrl              String?
  sonarrApiKey           String?
  sonarrRootFolder       String? @default("/tv")
  sonarrQualityProfileId Int?    @default(1)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ListType {
  TODO
  MEDIA
  CALENDAR
}

model List {
  id          String       @id @default(cuid())
  title       String
  type        ListType     @default(TODO)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       Item[]
  sharedWith  ListAccess[]
  tagConfigs  TagConfig[]
  activities  Activity[]
  createdAt   DateTime     @default(now())
}

model TagConfig {
  id        String   @id @default(cuid())
  name      String
  color     String
  listId    String
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listId, name])
}

enum ItemStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum ItemType {
  TASK
  MEDIA
}

enum MediaType {
  MOVIE
  SHOW
  GAME
}

model Item {
  id        String     @id @default(cuid())
  title     String
  notes     String?
  status    ItemStatus @default(TODO)
  dueDate   DateTime?
  type      ItemType   @default(TASK)
  mediaType MediaType?
  color     String?
  tags      String[]
  listId    String
  list      List       @relation(fields: [listId], references: [id], onDelete: Cascade)
  media     MediaMetadata?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MediaMetadata {
  id            String  @id @default(cuid())
  itemId        String  @unique
  item          Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  posterPath    String?
  rating        Float?
  externalId    String?
  streamingInfo Json?
}

enum FollowType {
  PERSON
  STUDIO
  SERIES
}

model Follow {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId    String     // TMDB or RAWG ID
  type          FollowType
  mediaType     MediaType
  name          String
  posterPath    String?
  lastCheckedAt DateTime?  @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([userId, externalId, type])
}

enum ActivityType {
  ITEM_CREATED
  ITEM_COMPLETED
  ITEM_DELETED
  LIST_SHARED
  FRIEND_ACCEPTED
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  listId    String?
  list      List?        @relation(fields: [listId], references: [id], onDelete: Cascade)
  itemId    String?
  itemTitle String?
  metadata  Json?        // For storing extra info like "Friend Name" or "List Title"
  createdAt DateTime     @default(now())

  @@index([listId])
  @@index([userId])
}
